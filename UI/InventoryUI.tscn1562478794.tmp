[gd_scene format=3 uid="uid://b2wnkc5vw885o"]

[sub_resource type="GDScript" id="GDScript_x0foe"]
script/source = "extends Control


# =========================================================
# READY
# =========================================================

func _ready() -> void:

	# =====================================================
	# ẨN BAN ĐẦU
	# =====================================================

	visible = false

	print(
		\"InventoryUI READY\"
	)


# =========================================================
# MỞ INVENTORY
# =========================================================

func open_inventory() -> void:

	visible = true

	print(
		\"INVENTORY OPEN\"
	)


# =========================================================
# ĐÓNG INVENTORY
# =========================================================

func close_inventory() -> void:

	visible = false

	print(
		\"INVENTORY CLOSE\"
	)


# =========================================================
# TOGGLE
# =========================================================

func toggle_inventory() -> void:

	if visible:

		close_inventory()

	else:

		open_inventory()
"

